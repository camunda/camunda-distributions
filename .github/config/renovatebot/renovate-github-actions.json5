{
  description: "Keeps GitHub Actions up to date",
  packageRules: [
    {
      semanticCommitScope: "github-actions",
      groupName: "github-actions",
      addLabels: ["deps/github-actions"],
      matchManagers: ["github-actions"],
      schedule: ["every weekend"],
    },
    {
      matchDepNames: ["camunda/team-distribution"],
      enabled: false,
    },
    {
      description: "camunda/infraex-terraform writes these caller workflows and updates their pins.",
      matchFileNames: [".github/workflows/crev-review.yml", ".github/workflows/lint.yml"],
      enabled: false,
    },
  ],
}
