{
  dependencyDashboard: true,
  labels: ["dependencies"],
  separateMinorPatch: true,
  vulnerabilityAlerts: {
    addLabels: ["security"],
  },
  minor: {
    enabled: true,
  },
  patch: {
    enabled: true,
  },
  packageRules: [
    {
      description: "Non-major updates: merged by the InfraEx dependency scanner. The label also mutes PR Slack notifications.",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      addLabels: ["automerge"],
    },
    {
      description: "Major updates need a human review.",
      matchUpdateTypes: ["major"],
      addLabels: ["upgrade:major"],
    },
    {
      description: "Alpha release candidates need a human review.",
      matchNewValue: "/.*alpha[0-9]*-rc[0-9]*/",
      addLabels: ["no merge"],
    },
  ],
  hostRules: [
    {
      hostType: "docker",
      matchHost: "https://registry.camunda.cloud",
      username: "{{ secrets.DISTRO_CAMUNDA_DOCKER_REGISTRY_USERNAME }}",
      password: "{{ secrets.DISTRO_CAMUNDA_DOCKER_REGISTRY_PASSWORD }}",
    },
  ],
}
